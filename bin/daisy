#!/usr/bin/env ruby
# DAISY CLI: one-shot (-p) or interactive REPL.

require "optparse"
require_relative "../lib/daisy"

options = { learn: false }
parser = OptionParser.new do |o|
  o.banner = "Usage: daisy --personality FILE [-p PROMPT] [--learn]"
  o.on("--personality FILE", "Path to .DSY memory file (required)") { |v| options[:personality] = v }
  o.on("-p", "--prompt PROMPT", "One-shot: respond to PROMPT and exit") { |v| options[:prompt] = v }
  o.on("--learn", "Learn from input; save corpus on exit") { options[:learn] = true }
  o.on("--seed N", Integer, "Seed the RNG (for deterministic output)") { |v| options[:seed] = v }
  o.on("--timeout SECS", Float, "Wall-clock cap on response generation (default 0.5; 0 to disable)") { |v| options[:timeout] = v }
  o.on("-h", "--help") { puts o; exit 0 }
end
parser.parse!

unless options[:personality]
  warn parser.help
  exit 1
end

unless File.exist?(options[:personality])
  warn "personality file not found: #{options[:personality]}"
  exit 1
end

corpus = Daisy::Corpus.load(options[:personality])
rng = options[:seed] ? Random.new(options[:seed]) : Random.new
bot_opts = { rng: rng }
if options.key?(:timeout)
  bot_opts[:timeout] = options[:timeout].zero? ? nil : options[:timeout]
end
bot = Daisy::Bot.new(corpus, **bot_opts)

save_if_learning = -> {
  corpus.save(options[:personality]) if options[:learn]
}

if options[:prompt]
  puts bot.respond(options[:prompt], learn: options[:learn])
  save_if_learning.call
  exit 0
end

trap("INT") do
  save_if_learning.call
  exit 0
end

loop do
  print "> "
  $stdout.flush
  line = $stdin.gets
  break if line.nil?
  line = line.chomp
  next if line.empty?
  break if %w[exit quit].include?(line.downcase)
  reply = bot.respond(line, learn: options[:learn])
  puts "#{corpus.bot_name}> #{reply}"
end

save_if_learning.call
